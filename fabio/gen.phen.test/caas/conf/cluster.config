/*
 * User-editable CAAStools pooled-discovery and SLURM configuration.
 * RERconverge is intentionally absent from this workflow.
 */

params {
    // Reuse the alignment collection already managed by the discovery workflow.
    alignments = "${projectDir}/../lq.table2.nextflow/inputs/alignments/*.phy"

    // Manifest of the three pre-generated, reproducible benchmark strategies.
    // Nextflow crosses these configurations with all alignments so that the
    // family, absolute-tail and PSS-informed analyses run independently.
    benchmark_manifest = "${projectDir}/inputs/benchmark.configs.tsv"

    // Generated results remain outside Git through the workflow .gitignore.
    results_root = "${projectDir}/results"

    // Bundled CAAStools copy and interpreter.
    caastools_dir = "${projectDir}/bin/caastools"
    python_command = 'python3'

    // CAAStools pooled-discovery options.
    caas_alignment_format = 'phylip-relaxed'
    caas_filter_significant = '0.05'  // Set to 'no' to disable the hypergeometric filter.
    caas_patterns = '1,2,3'
    caas_max_bg_gaps = 'NO'
    caas_max_fg_gaps = 'NO'
    caas_max_gaps = 'NO'
    caas_max_gaps_per_position = '0.5'
    caas_max_bg_miss = 'NO'
    caas_max_fg_miss = 'NO'
    caas_max_miss = 'NO'
    // Each hypothesis is evaluated only with at least this many present, non-gap species per group.
    caas_min_fg_observed = 3
    caas_min_bg_observed = 3

    // SLURM routing. Empty strings omit the corresponding option.
    slurm_partition = 'std-cpu'
    slurm_account = ''
    slurm_qos = ''
    slurm_constraint = ''

    // Conda initialization repeated inside every SLURM analysis task.
    conda_init_script = '/homes/aplic/noarch/software/Miniconda3/23.9.0-0/etc/profile.d/conda.sh'
    conda_environment = 'phyloq'

    // Optional additional command executed after Conda activation.
    caas_before_script = ''
}

process {
    executor = 'slurm'
    queue = params.slurm_partition ?: null
    clusterOptions = (params.slurm_account ? "--account=${params.slurm_account} " : '') +
                     (params.slurm_qos ? "--qos=${params.slurm_qos} " : '') +
                     (params.slurm_constraint ? "--constraint=${params.slurm_constraint}" : '')

    withName: CAASTOOLS_POOLED_BENCHMARK {
        cpus = 1
        memory = '2 GB'
        time = '30m'
        beforeScript = "source '${params.conda_init_script}'; conda activate '${params.conda_environment}'" +
                       (params.caas_before_script ? "; ${params.caas_before_script}" : '')
    }
}

executor {
    queueSize = 100
    submitRateLimit = '10 sec'
}

workDir = "${projectDir}/work"
