    if pooled_discovery_mode and options.pooled_fg_size < 1:
        missing_option_messages.append("--fg_size must be at least 1")

    if pooled_discovery_mode and options.pooled_bg_size < 1:
        missing_option_messages.append("--bg_size must be at least 1")

    if str(options.summarize_species).lower() not in ("yes", "no"):
        missing_option_messages.append("--summarize_species must be 'yes' or 'no'")
    
    if len(missing_option_messages) > 0:
        print("\n" + application_info)
        print("\n\n****ERROR: mandatory i/o information missing:")
        print("\n".join(missing_option_messages))
        print("")
        print(parser.usage)
        print("")
        print("For further info: ct " + tool.lower() + " --help")
        print("")
        sys.exit(1)

    significance_threshold = "no"

    if str(options.filter_significant).lower() != "no":
        try:
            significance_threshold = float(options.filter_significant)
        except ValueError:
            print("\n\n****ERROR: --filter_significant must be 'no' or a numeric p-value threshold between 0 and 1")
            print("")
            sys.exit(1)

        if not 0 <= significance_threshold <= 1:
            print("\n\n****ERROR: --filter_significant must be between 0 and 1")
            print("")
            sys.exit(1)

    ### 3.8 Import the modules

    from modules.boot import *
    from modules.init_bootstrap import (
        pool_discovery_hypotheses,
        simtrait_revive,
        validate_pooled_hypotheses,
    )
    from modules.runslice import runslice

    ### 3.9 PROCEDURE 

    print(application_info)
    print("")

    tool_label = "POOLED DISCOVERY TOOL" if pooled_discovery_mode else "BOOTSTRAP TOOL"
    print("[" + tool_label + "] - Scanning", options.single_alignment, "with phenotype information from", options.config_file + "\n\n")

    ###     3.9.1 - Build or read the hypotheses

    hypotheses_output_file = None
    if pooled_discovery_mode:
        if options.simtraits != "none":
            try:
                bootstrap_object = validate_pooled_hypotheses(
                    simtrait_revive(options.simtraits),
                    options.config_file,
                )
            except ValueError as pooling_error:
                print("\n\n****ERROR: cannot load saved pooled hypotheses:", str(pooling_error))
                print("")
                sys.exit(1)
            try:
                loaded_fg_size, loaded_bg_size = infer_resampled_group_sizes(bootstrap_object)
            except ValueError as pooling_error:
                print("\n\n****ERROR: invalid saved pooled hypotheses:", str(pooling_error))
                print("")
                sys.exit(1)
            options.pooled_fg_size = loaded_fg_size
            options.pooled_bg_size = loaded_bg_size
            hypotheses_source = "loaded"
        else:
            try:
                bootstrap_object = pool_discovery_hypotheses(
                    pool_file=options.config_file,
                    fg_size=options.pooled_fg_size,
                    bg_size=options.pooled_bg_size,
                    comparisons=options.pooled_comparisons,
                    seed=options.pooled_seed,
                )
            except ValueError as pooling_error:
                print("\n\n****ERROR: cannot generate pooled hypotheses:", str(pooling_error))
                print("")
                sys.exit(1)
            hypotheses_source = "generated"

            if str(options.hypotheses_output_file).lower() != "none":
                if str(options.hypotheses_output_file).lower() == "auto":
                    hypotheses_output_file = splitext(options.output_file)[0] + ".hypotheses.tsv"
                else:
                    hypotheses_output_file = options.hypotheses_output_file
                bootstrap_object.print_traits(hypotheses_output_file)

        # Preserve the candidate-position behavior of an equivalent external
        # resampling file instead of using the complete discovery-pool sizes.
        options.slice_fg_size_override = options.pooled_fg_size
        options.slice_bg_size_override = options.pooled_bg_size

        print("[POOLED DISCOVERY TOOL] - " + ("Saved hypothesis reuse" if hypotheses_source == "loaded" else "Internal hypothesis pooling"))
        print("Complete pools: FG=" + str(len(bootstrap_object.discovery_fg)) + ", BG=" + str(len(bootstrap_object.discovery_bg)))
        print("Hypothesis sizes: FG=" + str(options.pooled_fg_size) + ", BG=" + str(options.pooled_bg_size))
        if hypotheses_source == "generated":
            print("Possible unique comparisons:", bootstrap_object.pool_maximum_comparisons)
            print("Seed:", options.pooled_seed)
        print("Selected comparisons:", bootstrap_object.cycles)
        if hypotheses_source == "loaded":
            print("Hypotheses input:", options.simtraits)
        if hypotheses_output_file is not None:
            print("Hypotheses output:", hypotheses_output_file)
        print("")
    else:
        bootstrap_object = simtrait_revive(options.simtraits)

    try:
        fg_size, bg_size = infer_resampled_group_sizes(bootstrap_object)
    except ValueError as group_size_error:
        print("\n\n****ERROR: invalid resampled traits:", str(group_size_error))
        print("")
        sys.exit(1)

    ###     3.9.2 - Slice the alignment

    sliced_alignment = runslice(options)

    if options.min_fg_observed > fg_size:
        print("\n\n****ERROR: --min_fg_observed cannot exceed the foreground group size (" + str(fg_size) + ")")
        print("")
        sys.exit(1)

    if options.min_bg_observed > bg_size:
        print("\n\n****ERROR: --min_bg_observed cannot exceed the background group size (" + str(bg_size) + ")")
        print("")
        sys.exit(1)

    summarize_species = str(options.summarize_species).lower() == "yes"
    if options.event_output_file != "none":
        summarize_species = True

    event_output_file = None
    if summarize_species:
        if options.event_output_file == "none":
            event_output_file = splitext(options.output_file)[0] + ".events.tsv"
        else:
            event_output_file = options.event_output_file

        try:
            discovery_fg, discovery_bg = infer_fixed_discovery_groups(bootstrap_object)
        except ValueError as event_error:
            print("\n\n****ERROR: cannot create species event summaries:", str(event_error))
            print("")
            sys.exit(1)

        print("[" + tool_label + "] - Species/amino-acid event summaries")
        print("Fixed discovery pools: FG=" + str(len(discovery_fg)) + ", BG=" + str(len(discovery_bg)))
        print("Event output:", event_output_file)
        print("")

    print("[" + tool_label + "] - Minimum observed species per hypothesis")
    print("Foreground:", options.min_fg_observed, "of", fg_size)
    print("Background:", options.min_bg_observed, "of", bg_size)
    print("")

    ###     3.9.3 - Optionally filter positions by hypergeometric significance

    if significance_threshold != "no":
        try:
            positions_before_filtering, positions_after_filtering = filter_positions_by_hypergeometric_pvalue(
                sliced_object = sliced_alignment,
                fg_size = fg_size,
                bg_size = bg_size,
                threshold = significance_threshold
            )
        except ValueError as filter_error:
            print("\n\n****ERROR: cannot apply --filter_significant:", str(filter_error))
            print("")
            sys.exit(1)

        print("[" + tool_label + "] - Hypergeometric significance filter")
        print("Threshold:", significance_threshold)
        print("Resampled group sizes: FG=" + str(fg_size) + ", BG=" + str(bg_size))
        print("Positions before filtering:", positions_before_filtering)
        print("Positions retained:", positions_after_filtering)
        print("")

    ###     3.9.4 - Boot on the alignment file
    boot_on_single_alignment(
                    trait_config_file= options.config_file,
                    resampled_traits= bootstrap_object,
                    sliced_object = sliced_alignment,

                    max_fg_gaps = options.max_fg_gaps_string,
                    max_bg_gaps = options.max_bg_gaps_string,
                    max_overall_gaps = options.max_gaps_string,
                    
                    max_fg_miss = options.max_fg_miss_string,
                    max_bg_miss = options.max_bg_miss_string,
                    max_overall_miss = options.max_miss_string,

                    min_fg_observed = options.min_fg_observed,
                    min_bg_observed = options.min_bg_observed,

                    the_admitted_patterns = options.patterns_string,
                    output_file = options.output_file,
                    event_output_file = event_output_file
                    )
    
    ###     3.9.5 Final output
    print("\n\n" + ("Pooled discovery" if pooled_discovery_mode else "Bootstrap") + " information available in", options.output_file)
    if event_output_file is not None:
        print("Species/amino-acid events available in", event_output_file)
    if hypotheses_output_file is not None:
        print("Pooled hypotheses available in", hypotheses_output_file)
