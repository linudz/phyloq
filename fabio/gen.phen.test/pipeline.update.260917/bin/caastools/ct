    parser.add_option("--min_bg_observed", "--min-bg-observed", dest="min_bg_observed",
                    type="int",
                    help="Minimum number of background species that must be present in the alignment and non-gapped at a position for a bootstrap cycle to be evaluated. Default: 1.",
                    default=1)


