params {
    stage = null
    direct_discovery = false
    synthetic_inputs = false
    run_id = null
    design = null
    selection_manifest = null
    alignment_manifest = null
    cohort_manifest = null
    approvals = null
    settings = "${projectDir}/inputs/settings.json"
    results_root = "${projectDir}/results"
    summaries_root = "${projectDir}/summaries"
    caastools_dir = "${projectDir}/bin/caastools"
    python_command = 'python3'
    r_command = 'Rscript'
    code_fingerprint = null
    annotation_input = "${projectDir}/inputs/annotations.disabled.txt"
    annotation_backend = 'disabled'
    launch_id = 'unbound'
    partition = 'std-cpu'
    account = ''
    task_cpus = 1
    task_memory = '2 GB'
    task_time = '30m'
    task_environment = ''
    runtime_setup = ''
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']
    beforeScript = params.runtime_setup + 'export PYTHONDONTWRITEBYTECODE=1; export PYTHONHASHSEED=0'
    withName: CAAS_POOLED { cpus = params.task_cpus; memory = params.task_memory; time = params.task_time }
}
profiles {
    local { process.executor = 'local' }
    cluster { includeConfig 'conf/cluster.config' }
}
workDir = "${projectDir}/work"
cleanup = false
// One reviewed, pre-created Conda environment for driver and workers; do not
// create a separate environment inside each of millions of gene-level tasks.
conda.enabled = false
docker.enabled = false
singularity.enabled = false
trace { enabled = true; file = "${params.results_root}/${params.run_id ?: 'prepare'}/nextflow.${params.launch_id}.trace.tsv"; overwrite = false; fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar' }
