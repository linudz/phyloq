manifest {
    name = 'primate-pss-parametric-bootstrap-correfoc'
    author = 'PSS primate traits project'
    description = 'Independent conditional and full parametric bootstrap on Slurm'
    nextflowVersion = '>=24.04.0'
}

workDir = "${projectDir}/work"

def slurmOptions = []
if (params.slurm_account) slurmOptions << "--account=${params.slurm_account}"
if (params.slurm_qos) slurmOptions << "--qos=${params.slurm_qos}"
if (params.slurm_cluster_options) slurmOptions << params.slurm_cluster_options.toString()

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: bootstrap {
        cpus = { params.bootstrap_cpus as int }
        memory = { params.bootstrap_memory }
        time = { params.bootstrap_time }
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withLabel: aggregate {
        cpus = { params.aggregate_cpus as int }
        memory = { params.aggregate_memory }
        time = { params.aggregate_time }
        errorStrategy = 'terminate'
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        process.maxForks = params.max_parallel_jobs as int
        process.conda = "${projectDir}/environment.yml"
        if (params.slurm_partition) process.queue = params.slurm_partition
        if (slurmOptions) process.clusterOptions = slurmOptions.join(' ')
        conda.enabled = true
        conda.cacheDir = "${projectDir}/${params.conda_cache_dir}"
    }

    local {
        process.executor = 'local'
        process.maxForks = 2
        conda.enabled = false
    }
}

timeline {
    enabled = true
    file = "${projectDir}/results/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${projectDir}/results/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${projectDir}/results/execution_trace.tsv"
    overwrite = true
}
