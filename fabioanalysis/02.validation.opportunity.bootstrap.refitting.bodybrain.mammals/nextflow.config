manifest {
    name = 'mammalian-brain-body-pss'
    author = 'PSS mammalian case-study project'
    description = 'Venditti mammalian brain/body allometry, PSS, opportunity depth and BM/OU bootstrap'
    nextflowVersion = '>=24.04.0, <27.0.0'
}

params {
    output_dir = 'results'
    slurm_partition = 'std-cpu'
    slurm_cluster_options = ''
    max_parallel_jobs = 100
    prepare_cpus = 1
    prepare_memory = '8 GB'
    prepare_time = '4h'
    observed_cpus = 1
    observed_memory = '16 GB'
    observed_time = '12h'
    bootstrap_cpus = 1
    conditional_memory = '16 GB'
    conditional_time = '12h'
    full_memory = '24 GB'
    full_time = '24h'
    aggregate_cpus = 1
    aggregate_memory = '8 GB'
    aggregate_time = '4h'
    conda_cache_dir = '.nextflow-conda'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: prepare {
        cpus = { params.prepare_cpus as int }
        memory = { params.prepare_memory }
        time = { params.prepare_time }
        errorStrategy = 'terminate'
    }
    withLabel: observed {
        cpus = { params.observed_cpus as int }
        memory = { params.observed_memory }
        time = { params.observed_time }
        errorStrategy = 'terminate'
    }
    withLabel: bootstrap {
        cpus = { params.bootstrap_cpus as int }
        errorStrategy = 'retry'
        maxRetries = 2
    }
    withLabel: aggregate {
        cpus = { params.aggregate_cpus as int }
        memory = { params.aggregate_memory }
        time = { params.aggregate_time }
        errorStrategy = 'terminate'
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        process.maxForks = params.max_parallel_jobs as int
        process.conda = "${projectDir}/../../environment.yml"
        process.queue = params.slurm_partition
        process.clusterOptions = params.slurm_cluster_options
        conda.enabled = true
        conda.cacheDir = "${System.getenv('SCRATCH') ?: projectDir}/${params.conda_cache_dir}"
    }
    local {
        process.executor = 'local'
        process.maxForks = 2
        process.conda = "${projectDir}/../../environment.yml"
        conda.enabled = true
        conda.cacheDir = "${System.getenv('SCRATCH') ?: projectDir}/${params.conda_cache_dir}"
    }
}

workDir = "${System.getenv('SCRATCH') ?: System.getenv('TMPDIR') ?: '/tmp'}/mammal-brain-body-validation-work"

timeline {
    enabled = true
    file = "${projectDir}/${params.output_dir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${projectDir}/${params.output_dir}/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${projectDir}/${params.output_dir}/execution_trace.tsv"
    overwrite = true
}
